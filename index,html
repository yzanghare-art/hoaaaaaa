        /* Lớp hiệu ứng trang trí dễ thương */
        .decor {
            position: absolute;
            pointer-events: none;
            user-select: none;
        }

        /* Hoa ly trang trí các góc */
        .lily-top-left { top: -20px; left: -20px; width: 220px; transform: rotate(15deg); }
        .lily-top-right { top: -20px; right: -20px; width: 220px; transform: rotate(-15deg); }
        .lily-bottom-left { bottom: -20px; left: -20px; width: 240px; transform: rotate(-10deg); }
        .lily-bottom-right { bottom: -20px; right: -20px; width: 240px; transform: rotate(10deg); }

